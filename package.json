{
  "name": "seasons-wallpaper-studio",
  "version": "1.0.0",
  "description": "四季动态循环壁纸工作室：同一场景四季切换、参数可调、无缝循环、可导出 MP4",
  "type": "module",
  "scripts": {
    "start": "python -m http.server 8080",
