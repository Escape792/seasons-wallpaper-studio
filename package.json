    "batch:portrait": "node tools/batch.mjs portrait"
  },
  "keywords": ["wallpaper", "dynamic-wallpaper", "canvas", "seasons", "loop", "mp4"],
  "license": "MIT",
  "devDependencies": {
    "ffmpeg-static": "^5.2.0",
    "puppeteer-core": "^23.11.1"
  }
